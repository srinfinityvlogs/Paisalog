# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Any random string you make up yourself — protects your webhook endpoint
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# Only your Telegram user id is allowed to use the bot (recommended).
# Get yours by messaging @userinfobot on Telegram. Leave blank to allow anyone.
ALLOWED_TELEGRAM_USER_ID=

# --- Google Sheets (via Apps Script proxy — no service account key needed) ---
# From google-apps-script-proxy/Code.gs, deployed as a Web App
SHEETS_PROXY_URL=https://script.google.com/macros/s/AKfycb.../exec
SHEETS_PROXY_SECRET=change-me-to-a-different-random-string

# --- Alternative: direct Sheets API with a service account key ---
# Only needed if your GCP org allows service account keys and you swapped
# lib/sheets.js back to calling the Sheets API directly instead of the proxy.
# GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContent\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz123456

# --- OCR ---
# Get a free key (no credit card) at https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your-ocr-space-free-key

# --- Deployment (used by scripts/set-webhook.js) ---
# e.g. https://your-project.vercel.app  (no trailing slash)
BASE_URL=
